global:
  resolve_timeout: 5m

route:
  receiver: matrix-warning
  group_by: ["alertname", "job", "instance"]
  group_wait: 10s
  group_interval: 5m
  repeat_interval: 2h

receivers:
  - name: matrix-warning
    webhook_configs:
      - url: "http://matrix-hookshot:9000/webhook/REPLACE_ME"
        send_resolved: true
